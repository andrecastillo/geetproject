# build output
/geetproject
/web/dist/*
!/web/dist/.gitkeep
/web/node_modules/

# local data
*.db
*.db-wal
*.db-shm
/testdata/

# editor / os
.DS_Store
*.swp

# A global ~/.gitignore_global rule (*.sql) would otherwise exclude the embedded
# schema, which silently produces a repo that cannot compile: embed.go and
# store.go both go:embed files that must be present at checkout.
!internal/store/schema.sql
