# Run geet as a per-user service, so the CLI always has a server to talk to.
#
#   mkdir -p ~/.config/systemd/user
#   cp contrib/geet.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now geet
#
# For it to survive logout: sudo loginctl enable-linger $USER
#
# Not needed if you point GEET_URL at a container running elsewhere.

[Unit]
Description=geet task tracker
After=network.target

[Service]
ExecStart=%h/.local/bin/geet serve
Environment=GEET_ADDR=127.0.0.1:8080
Environment=GEET_DB=%h/.local/share/geet/geet.db
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
